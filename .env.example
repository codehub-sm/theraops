# ===========================================
# TheraFlow Marketing Automation - Environment
# ===========================================
# Copy this to .env and fill in your values

# --- Claude API ---
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Founder / Product ---
FOUNDER_NAME=YourName
PRODUCT_NAME=TheraFlow
PRODUCT_URL=https://theraflow.in
DEMO_BOOKING_URL=https://theraflow.in/demo

# --- Google Places API ---
GOOGLE_PLACES_API_KEY=AIzaSy-xxxxx

# --- Airtable ---
AIRTABLE_API_KEY=patXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXX
AIRTABLE_LEADS_TABLE=Leads

# --- Gmail SMTP (for sending emails) ---
GMAIL_SENDER_EMAIL=you@theraflow.in
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- Gmail API (for monitoring replies) ---
# Place credentials.json from Google Cloud Console in project root
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# --- Tracking ---
TRACKING_BASE_URL=https://track.theraflow.in

# --- LinkedIn (manual prep, no API needed) ---
LINKEDIN_PROFILE_URL=https://linkedin.com/in/yourprofile

# --- Scheduling ---
SCRAPER_CITIES=Mumbai,Delhi,Bangalore,Hyderabad,Chennai,Pune,Kolkata,Ahmedabad
SCRAPER_RUN_DAY=Monday
EMAIL_SEND_DAYS=Tuesday,Thursday
REPORT_DAY=Sunday
LINKEDIN_PREP_DAY=Monday

# --- Limits ---
MAX_EMAILS_PER_DAY=50
MAX_LEADS_PER_SCRAPE=100
